APP_NAME=GovPay
APP_SECRET_KEY=generate-a-random-value-at-least-32-characters
SESSION_SECRET_KEY=generate-a-different-random-value-at-least-32-characters
DATABASE_URL=postgresql+psycopg://govpay_user:change-this@127.0.0.1:5432/govpay
CRYPTO_MAC_SECRET=generate-a-third-random-value-at-least-32-characters
KMS_PATH=.govpay-kms.json
KMS_WRAP_PUBLIC_KEY_JSON={"n":0,"e":65537}
KMS_WRAP_PRIVATE_KEY_JSON={"n":0,"d":0,"e":65537}
DEBUG=true
ENVIRONMENT=development
SECURE_COOKIES=false
SESSION_MAX_AGE_SECONDS=1800
OTP_DELIVERY_MODE=console
